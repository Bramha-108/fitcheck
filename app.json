{
  "expo": {
    "name": "Fitcheck",
    "slug": "fitcheck",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fitcheck.app",
      "adaptiveIcon": {
        "backgroundColor": "#16150F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fitcheck uses your photo library to attach a reference photo to a garment. Photos are copied locally and never leave your device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withMinimalPermissions.js",
      "./plugins/withReleaseSigning.js",
      "expo-sharing"
    ]
  }
}
